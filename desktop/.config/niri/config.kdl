// niri config — desktop (DP-1 3440x1440@180 primary + HDMI-A-1 1920x1080@60)
// https://niri-wm.github.io/niri/Configuration:-Introduction
//
// DMS integration: keybinds, colors, layout, alt-tab and wallpaper blur are
// auto-generated by DankMaterialShell into ~/.config/niri/dms/*.kdl
// (run insidan niri: `dms setup alttab binds colors layout`).

// === Environment (mirrors .config/environment.d/90-dms.conf + hypr env) ===
environment {
    // NVIDIA
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    LIBVA_DRIVER_NAME "nvidia"

    // Qt / Electron on Wayland
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// === Input (mirrors .config/hypr/configs/input.lua) ===
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
        repeat-rate 30
        repeat-delay 270
    }

    touchpad {
        tap
        natural-scroll
        scroll-factor 0.4
    }

    mouse {
        accel-profile "flat"
        accel-speed 0
    }
}

// === Outputs (desktop) ===
output "DP-1" {
    mode "3440x1440@180"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=3440 y=0
}

// === Autostart ===
// X11 apps run via xwayland-satellite (niri has no built-in XWayland)
spawn-at-startup "xwayland-satellite"
spawn-at-startup "easyeffects" "--gapplication-service"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"

// === Window & layer rules ===
// Put the DMS/quickshell wallpaper onto the overview
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// Work around WezTerm's initial configure bug
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox picture-in-picture floats
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// DMS/quickshell modal windows (spotlight, settings, etc.) float
window-rule {
    match app-id=r#"^org\.quickshell$"#
    open-floating true
}

// === DMS-generated fragments (colors, layout, binds, alt-tab, blur) ===
include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/colors.kdl"
include "dms/layout.kdl"
include "dms/wpblur.kdl"

// === Personal app binds (mirrors .config/hypr/configs/keybinds.lua) ===
// Window/workspace management and DMS IPC live in dms/binds.kdl.
binds {
    Mod+Return { spawn "ghostty"; }
    Mod+B { spawn "firefox"; }
    Mod+E { spawn "nautilus"; }
    Mod+Shift+D { spawn "com.discordapp.Discord"; }
    Mod+Alt+T { spawn "Telegram"; }
    Mod+Shift+Return { spawn "brave"; }
}