# Ghostty config (динамическая тема из обоев Noctalia)
font-family = JetBrains Mono
font-size = 11

window-padding-x = 8
window-padding-y = 8
background-opacity = 0.92
background-blur-radius = 20
confirm-close-surface = false

theme = noctalia

# Шлейф курсора + лёгкое свечение (GLSL-шейдеры, подхватывают цвета темы Noctalia)
custom-shader = shaders/cursor_sweep.glsl
custom-shader = shaders/bloom.glsl

# Перезагрузка конфига на лету
keybind = ctrl+shift+r=reload_config
