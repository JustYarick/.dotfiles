# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust values for your machine:
#   cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenCode & AI Services
# ------------------------------------------------------------------------------
# Ollama OpenAI-compatible API base URL (used by OpenCode, DSH, etc.)
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"

# Ollama API key (if required by your reverse proxy / remote endpoint)
OLLAMA_API_KEY=""

# Ollama daemon host bind address and port
OLLAMA_HOST="0.0.0.0:11434"

# Allowed origins for Ollama API
OLLAMA_ORIGINS="*"

# Context window size for Ollama models (in tokens)
OLLAMA_CONTEXT_LENGTH="65536"

# Flash Attention optimization (1 to enable, 0 to disable)
OLLAMA_FLASH_ATTENTION="1"

# KV Cache quantization type (e.g. f16, q8_0, q4_0)
OLLAMA_KV_CACHE_TYPE="q8_0"

# Number of parallel model requests
OLLAMA_NUM_PARALLEL="1"

# Duration to keep models in VRAM (e.g. 5m, 15m, 1h, -1 for indefinite)
OLLAMA_KEEP_ALIVE="15m"

# ------------------------------------------------------------------------------
# Android SDK & Tooling
# ------------------------------------------------------------------------------
ANDROID_HOME="$HOME/Android/Sdk"
ANDROID_EMULATOR_USE_SYSTEM_LIBS="1"

# ------------------------------------------------------------------------------
# Default Applications & Binaries
# ------------------------------------------------------------------------------
CHROME_EXECUTABLE="/usr/bin/google-chrome-stable"
EDITOR="nvim"

# ------------------------------------------------------------------------------
# Wayland & Desktop Environment (DMS / Qt / Electron)
# ------------------------------------------------------------------------------
QT_QPA_PLATFORM="wayland"
QT_QPA_PLATFORMTHEME="gtk3"
ELECTRON_OZONE_PLATFORM_HINT="auto"

# ------------------------------------------------------------------------------
# Network & Captive Portal Dispatcher
# ------------------------------------------------------------------------------
PORTAL_URL="http://ping.archlinux.org/nm-check.txt"
