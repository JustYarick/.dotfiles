{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    
    "modules-left": ["hyprland/workspaces", "hyprland/language", "custom/playerctl"],
    "modules-center": ["clock"],
    "modules-right": ["custom/cpu", "custom/gpu", "network", "bluetooth", "pulseaudio", "pulseaudio#microphone", "idle_inhibitor", "custom/notification", "custom/updates", "group/background", "custom/exit"],

    "custom/cpu": {
      "exec": "bash -c 'u=$(top -bn1 | grep \"Cpu(s)\" | awk \"{print 100 - \\$8}\" | cut -d. -f1); t=$(($(cat /sys/class/hwmon/hwmon1/temp1_input)/1000)); g=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor); i=\"\"; [ \"$g\" = \"performance\" ] && i=\"\"; echo \"{\\\"text\\\": \\\"$i ${t}°C ${u}%\\\", \\\"tooltip\\\": \\\"CPU Temp: ${t}°C\\\\nCPU Usage: ${u}%\\\\nGovernor: ${g}\\\\n\\\\nLeft-click: Open Monitor\\\\nRight-click: Cycle Mode\\\", \\\"class\\\": \\\"$g\\\"}\"'",
      "return-type": "json",
      "format": "{}",
      "interval": 5,
      "signal": 8,
      "on-click": "ghostty -e htop",
      "on-click-right": "pkexec bash -c 'g=($(cpupower frequency-info -g | grep -oP \"governors: \\K.*\")); c=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor); for i in ${!g[@]}; do if [ \"${g[i]}\" = \"$c\" ]; then cpupower frequency-set -g ${g[((i+1)%${#g[@]})]}; break; fi; done'; pkill -RTMIN+8 waybar"
    },

    "custom/updates": {
        "format": "󰏗 {}",
        "interval": 3600,
        "exec": "$HOME/.config/waybar/custom_modules/updates.sh",
        "return-type": "json",
        "on-click": "kitty -e yay",
        "max-length": 8,
        "min-length": 3
    },

    "group/background": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "tray-child",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/tray-icon",
            "tray"
        ]
    },

    "custom/tray-icon": {
        "format": "",
        "tooltip": false
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": []
        },
        "format": "{icon}",
        "format-icons": {
            "1": "Ⅰ",
            "2": "Ⅱ",
            "3": "Ⅲ",
            "4": "Ⅳ",
            "5": "Ⅴ",
            "6": "Ⅵ",
            "7": "Ⅶ",
            "8": "Ⅷ",
            "9": "Ⅸ",
            "10": "Ⅹ",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "clock": {
        "interval": 10,
        "format": " {:%H:%M   %a %e/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gnome-calendar"
    },
    "bluetooth": {
        "interval": 30,
        "format": "{icon}",
        "format-icons": {
            "enabled": "",
            "disabled": ""
        },
        "on-click": "blueman-manager"
    },    
    "hyprland/language": {
        "format": "  {}",
        "format-en": "English",
        "format-ru": "Russian"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip": "true"
    },
    "custom/gpu": {
      "exec": "$HOME/.config/waybar/custom_modules/custom-gpu-nvidia.sh",
      "return-type": "json",
      "format": "{}",
      "interval": 5,
      "tooltip": "{tooltip}"
    },     
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "Connected",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "",
        "tooltip-format-wifi": "  {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%",
        "tooltip-format-ethernet": "  {ifname}\nIP: {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "scroll-step": 3,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "  {icon}  ",
        "format-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [" ", " ", "  "]
        },
        "on-click": "easyeffects"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    },
    "custom/playerctl": {
        "exec": "$HOME/.config/waybar/custom_modules/media-player-status.py",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "max-length": 30
    },
    "tray": {
        "spacing": 15
    },

    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    }
}
