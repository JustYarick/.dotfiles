{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    
    "modules-left": [
        "hyprland/workspaces", 
        "hyprland/language", 
        "custom/playerctl"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/cpu", 
        "custom/gpu", 
        "network", 
        "bluetooth", 
        "pulseaudio", 
        "pulseaudio#microphone", 
        "idle_inhibitor", 
        "custom/notification", 
        "custom/updates", 
        "custom/battery", 
        "group/background", 
        "custom/exit"
    ],

    // --- LEFT MODULES ---

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "persistent-workspaces": {
            "1": [], "2": [], "3": []
        },
        "format": "{icon}",
        "format-icons": {
            "1": "Ⅰ", "2": "Ⅱ", "3": "Ⅲ", "4": "Ⅳ", "5": "Ⅴ",
            "6": "Ⅵ", "7": "Ⅶ", "8": "Ⅷ", "9": "Ⅸ", "10": "Ⅹ",
            "urgent": "", "focused": "", "default": ""
        }
    },

    "hyprland/language": {
        "format": "  {}",
        "format-en": "English",
        "format-ru": "Russian"
    },

    "custom/playerctl": {
        "exec": "$HOME/.config/waybar/scripts/media-player-status.py",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "max-length": 30
    },

    // --- CENTER MODULES ---

    "clock": {
        "interval": 10,
        "format": " {:%H:%M   %a %e/%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gnome-calendar"
    },

    // --- RIGHT MODULES ---

    "custom/cpu": {
        "exec": "$HOME/.config/waybar/scripts/cpu_info.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 5,
        "on-click": "ghostty -e btop",
        "on-click-right": "bash -c 'p=($(powerprofilesctl list | grep -oP \"^[ \\*]* \\K[a-z-]+(?=:)\")); c=$(powerprofilesctl get); for i in \"${!p[@]}\"; do if [ \"${p[i]}\" = \"$c\" ]; then next_idx=$(((i+1)%${#p[@]})); powerprofilesctl set \"${p[next_idx]}\"; break; fi; done'"
    },

    "custom/gpu": {
        "exec-if": "$HOME/.config/waybar/scripts/check-gpu.sh",
        "exec": "$HOME/.config/waybar/scripts/gpu_info.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 5,
        "tooltip": "{tooltip}"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "Connected",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "",
        "tooltip-format-wifi": "  {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%",
        "tooltip-format-ethernet": "  {ifname}\nIP: {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "interval": 30,
        "format": "{icon}",
        "format-icons": {
            "enabled": "",
            "disabled": ""
        },
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "scroll-step": 3,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "  {icon}  ",
        "format-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [" ", " ", "  "]
        },
        "on-click": "easyeffects"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip": "true"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/updates": {
        "format": "󰏗 {}",
        "interval": 3600,
        "exec": "$HOME/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "on-click": "ghostty -e yay",
        "max-length": 8,
        "min-length": 3
    },

    "custom/battery": {
        "exec": "$HOME/.config/waybar/scripts/battery_info.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 30,
        "on-click": "ghostty -e htop"
    },

    "group/background": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "tray-child",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/tray-icon",
            "tray"
        ]
    },

    "custom/tray-icon": {
        "format": "",
        "tooltip": false
    },

    "tray": {
        "spacing": 15
    },

    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    }
}
